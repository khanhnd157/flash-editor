{
  "name": "@flash/ui",
  "version": "0.1.0",
  "description": "Flash Editor UI components — Toolbar, BubbleMenu, FloatingMenu, SlashCommand, LinkEditor",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@flash/core": "workspace:*",
    "@flash/model": "workspace:*",
    "@flash/state": "workspace:*",
    "@flash/commands": "workspace:*"
  },
  "sideEffects": false
}
